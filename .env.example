# Copy needed settings into apps/web/.env.local (ignored). No secret values belong here.
DATABASE_URL=postgresql://ibvs:CHANGE_ME@localhost:5432/ibvs
# Supabase uses the private ibvs schema. See docs/SUPABASE_SETUP.md for verified TLS.
DATABASE_SCHEMA=public
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Temporarily open as an administrator in a non-demo workspace. Set true to restore login.
IBVS_REQUIRE_SIGN_IN=false
IBVS_WORKSPACE_ID=billboard-operations
# Where photo originals go: database (hosted default), s3 (with IBVS_EVIDENCE_S3_*) or filesystem.
# IBVS_EVIDENCE_STORE=database
# Filesystem store only: absolute private directory outside apps/web. Back it up with the DB.
# IBVS_EVIDENCE_DIR=D:/IBVS-private-evidence
# Local only: omit DATABASE_URL to use .local/postgres. Production fails closed without DB and secret.
# IBVS_LOCAL_DB=D:/Billboard Tracking System/.local/postgres
# Location validation policy (public build-time settings; metres except age in milliseconds).
NEXT_PUBLIC_IBVS_LOCATION_RADIUS_M=100
NEXT_PUBLIC_IBVS_LOCATION_MAX_ACCURACY_M=100
NEXT_PUBLIC_IBVS_LOCATION_MAX_SOURCE_UNCERTAINTY_M=100
NEXT_PUBLIC_IBVS_LOCATION_MAX_AGE_MS=30000

# GPS promotion: a captured position needs reading accuracy at or below this many metres (pilot default 50; values above 50 are refused).
# IBVS_GPS_PROMOTION_MAX_ACCURACY_M=50
# Administrators must use two-factor authentication. This is enforced whenever sign-in is required (always in hosted production).
# Emergency recovery for a lost authenticator is an operator-only, audited command: scripts/admin-mfa-reset.ts (dry run by default).
