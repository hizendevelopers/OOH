# Set environment variables in the shell or use Node --env-file. No secret values belong here.
DATABASE_URL=postgresql://ibvs:CHANGE_ME@localhost:5432/ibvs
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Absolute private directory, outside apps/web; required for production. Back it up with the DB.
# IBVS_EVIDENCE_DIR=D:/IBVS-private-evidence
# Local only: omit DATABASE_URL to use .local/postgres. Production fails closed without DB and secret.
# IBVS_LOCAL_DB=D:/Billboard Tracking System/.local/postgres
